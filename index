    <script>

        (function () {
            'use strict';
            const inputs = Array.from(document.querySelectorAll('[data-target]'));
            const poster = document.getElementById('poster');
            const button = document.getElementById('export-button');
            const status = document.getElementById('export-status');
            const quality = document.getElementById('quality');
            inputs.forEach(input => {
                const target = document.getElementById(input.dataset.target);
                if (!target) return;
                input.value = target.textContent.trim();
                input.addEventListener('input', () => { target.textContent = input.value || ' '; });
            });
            function updateStatus(message, error = false) { status.textContent = message; status.classList.toggle('error', error); }
            function loadBackupLibrary() {
                return new Promise((resolve, reject) => {
                    if (window.htmlToImage) { resolve(); return; }
                    const s = document.createElement('script');
                    s.src = 'https://unpkg.com/html-to-image@1.11.11/dist/html-to-image.min.js';
                    s.onload = () => window.htmlToImage ? resolve() : reject(new Error('Library unavailable'));
                    s.onerror = () => reject(new Error('Library unavailable'));
                    document.head.appendChild(s);
                });
            }
            button.addEventListener('click', async () => {
                button.disabled = true;
                const oldText = button.textContent;
                button.textContent = 'جارٍ إعداد الصورة...';
                updateStatus('يتم تجهيز التصميم والخطوط بدقة عالية...');
                try {
                    if (!window.htmlToImage) await loadBackupLibrary();
                    if (document.fonts && document.fonts.ready) await document.fonts.ready;
                    // Inline original SVG paths are preserved during PNG export.
                    const scale = Number(quality.value);
                    // Capture the poster only, not the editor panel.
                    // Do not fill transparent corner pixels with a solid export background.
                    const canvas = await window.htmlToImage.toCanvas(poster, {
                        pixelRatio: scale,
                        backgroundColor: 'transparent',
                        cacheBust: true,
                        skipAutoScale: false,
                        style: {
                            // Preserve the poster's 1px border dimensions without
                            // rendering another outline under the final PNG border.
                            border: '1px solid transparent',
                            borderRadius: '0px',
                            overflow: 'hidden',
                            boxShadow: 'none'
                        }
                    });

                    // Clip the image ONCE and draw ONE perfectly matching border.
                    const output = document.createElement('canvas');
                    output.width = canvas.width;
                    output.height = canvas.height;
                    const ctx = output.getContext('2d');
                    if (!ctx) throw new Error('Canvas context unavailable');

                    const w = output.width;
                    const h = output.height;
                    const radius = Math.min(20 * scale, w / 2, h / 2);
                    const borderWidth = 1 * scale;
                    const inset = borderWidth / 2;

                    ctx.save();
                    ctx.beginPath();
                    ctx.roundRect(0, 0, w, h, radius);
                    ctx.clip();
                    ctx.drawImage(canvas, 0, 0);
                    ctx.restore();

                    // Border is centered half its width inside the same outer edge.
                    ctx.save();
                    ctx.strokeStyle = '#d7e5f6';
                    ctx.lineWidth = borderWidth;
                    ctx.beginPath();
                    ctx.roundRect(
                        inset, inset,
                        w - borderWidth, h - borderWidth,
                        Math.max(0, radius - inset)
                    );
                    ctx.stroke();
                    ctx.restore();

                    const blob = await new Promise(resolve =>
                        output.toBlob(resolve, 'image/png')
                    );

                    if (!blob || !blob.size) throw new Error('Empty image');
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'Alraedah_Grand_Prize_Winners_' + scale + 'x.png';
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    setTimeout(() => URL.revokeObjectURL(url), 30000);
                    updateStatus('تم تجهيز PNG بدقة ' + canvas.width + ' بكسل عرضًا.');
                } catch (error) {
                    console.error(error);
                    updateStatus('تعذّر تصدير الصورة. تأكد من اتصال الإنترنت وتحميل الخطوط والشعار. جرّب دقة 3× إذا لم يعمل 4×.', true);
                } finally {
                    button.disabled = false;
                    button.textContent = oldText;
                }
            });
        })();

    </script>
